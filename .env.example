# Telegram Bot Token (@BotFather orqali olinadi)
BOT_TOKEN=your_telegram_bot_token_here

# Database URL
# Lokal SQLite uchun (default):
DATABASE_URL=sqlite+aiosqlite:///./data/msbot.db

# Supabase / PostgreSQL uchun (production):
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Admin Telegram ID (ixtiyoriy)
ADMIN_IDS=123456789,987654321

# Default Mock Test sozlamalari
DEFAULT_TEST_TIME_LIMIT_MIN=150
